# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
LOG_LEVEL=INFO

# Giới hạn kích thước file và cache (giây)
MAX_FILE_SIZE_MB=30
CACHE_TTL_SECONDS=86400

# ==============================================================================
# OCR SERVICE CONFIGURATION
# ==============================================================================
# URL endpoint dịch vụ OCR tiếp nhận file PDF và trả về Markdown
OCR_SERVICE_URL=http://<ocr-service-host>:<port>/v1/extract
OCR_API_KEY=your_ocr_api_key_here
OCR_TIMEOUT_SECONDS=60
# Các tham số cấu hình bổ sung khi gọi OCR service endpoint (/v1/ocr/documents)
OCR_RASTERIZE=true
OCR_ENABLE_CORRECTION=true
OCR_PROCESS_TABLE=true
OCR_USE_CELERY=false
OCR_USE_CACHE=false

# ==============================================================================
# LLM SERVICE CONFIGURATION (Self-hosted model / OpenAI-compatible endpoint)
# ==============================================================================
# Base URL của service LLM (vd: vLLM, Ollama, TGI hoặc OpenAI compatible gateway)
LLM_API_BASE_URL=http://<llm-host>:<port>/v1
# Tên model LLM được deploy (vd: Qwen/Qwen2.5-72B-Instruct, Llama-3.1-70B-Instruct, ...)
LLM_MODEL_NAME=your_model_name_here
# API Key nếu service yêu cầu xác thực (nếu không cần thì để trống hoặc "EMPTY")
LLM_API_KEY=your_llm_api_key_here
# Tham số sinh text
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120